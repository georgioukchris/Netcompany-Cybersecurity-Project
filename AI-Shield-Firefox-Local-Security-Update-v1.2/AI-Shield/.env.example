POSTGRES_DB=ai_shield
POSTGRES_USER=ai_shield
POSTGRES_PASSWORD=replace_with_a_long_random_database_password
ADMIN_API_TOKEN=replace_with_a_long_random_admin_token
# Local extension-to-backend shared secret. This is NOT an OpenAI/ChatGPT API key.
SHADOW_INGEST_TOKEN=replace_with_a_long_random_extension_token
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Gemini is used only by the optional User Dashboard AI chat, not by ChatGPT.com Prompt Guard.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEBUG=false

# ---------------- NexGuard login (/login) ----------------
# First administrator, created on startup if it does not exist (the password is never overwritten later).
# Use a strong password: at least 10 characters with upper case, lower case and a number.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=NexGuard Admin
# Optional demo user for the Secure AI Chat (/app).
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
DEMO_USER_NAME=Demo User
# Local demos only: allow the demo user (not the admin) a short password such as "test".
DEMO_ALLOW_WEAK_PASSWORD=false
# Public address of the site (used in password-reset emails and for Google sign-in).
PUBLIC_BASE_URL=http://localhost:8000
# Set to true when the site is served over HTTPS (Secure cookie).
COOKIE_SECURE=false

# Forgot password: SMTP server for the reset email. Without SMTP_HOST no email is sent
# (with DEBUG=true the reset link is printed in `docker compose logs backend`, for local testing only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Google sign-in: create an OAuth client (type "Web application") in Google Cloud Console and add
# the authorized redirect URI  http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google accounts of these domains get a user account automatically (comma separated).
# Other Google accounts can sign in only if an account with the same email already exists.
GOOGLE_ALLOWED_DOMAINS=
