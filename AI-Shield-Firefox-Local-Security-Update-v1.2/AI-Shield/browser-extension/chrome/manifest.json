{
  "manifest_version": 3,
  "name": "AI Shield — Shadow Radar",
  "version": "1.5.1",
  "description": "AI domain discovery and reversible pseudonymization ([PERSON_001]) of prompts and attached PDFs, with local de-anonymization of AI responses.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "pseudonym-core.js",
        "prompt-guard.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
